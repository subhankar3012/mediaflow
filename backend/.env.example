# =====================================================================
# Downloader Engine Configuration (.env)
# =====================================================================

# Server configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Adapter Configuration:
# In development: 'sqlite', 'memory', or 'supabase'
# In production: MUST be 'supabase'
DB_ADAPTER=sqlite
SQLITE_DB_PATH=./downloader.db

# Supabase Credentials (Required if DB_ADAPTER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage & Temporary Paths
TEMP_STORAGE_PATH=/tmp/downloader
MAX_OUTPUT_SIZE_BYTES=2147483648  # 2 GB

# Processing Limits & Timeouts
MAX_JOB_DURATION_SECONDS=600       # 10 minutes
JOB_EXPIRATION_MINUTES=30          # Temporary media retained for 30 mins
ANALYSIS_EXPIRATION_MINUTES=60     # Analysis metadata retained for 60 mins

# Concurrency & Rate Limiting
MAX_CONCURRENT_JOBS_GLOBAL=5
MAX_CONCURRENT_JOBS_PER_SESSION=2
MAX_REQUESTS_PER_MINUTE=30

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
